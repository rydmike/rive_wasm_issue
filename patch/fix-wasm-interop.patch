From 1b315630d29e270dd1aece085fe54362d6f2eb9f Mon Sep 17 00:00:00 2001
From: rydmike <mrydstrom+gh@gmail.com>
Date: Wed, 21 Oct 2026 10:36:44 +0300
Subject: [PATCH 2/2] Refresh live Wasm buffer views before access

The Dart wrapper for a typed array caches its length under dart2wasm, so isEmpty cannot detect a detached view after memory growth. Recreate the heap view on every non-disposed access while retaining the disposed-pointer guard.
---
 lib/src/rive_native_web.dart | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/lib/src/rive_native_web.dart b/lib/src/rive_native_web.dart
index f82e3ce..c83bcd4 100644
--- a/lib/src/rive_native_web.dart
+++ b/lib/src/rive_native_web.dart
@@ -728,14 +728,9 @@ class WasmBuffer {
   final int size;
 
   Uint8List get data {
-    // As WebAssembly memory grows it might invalidate the JavaScript
-    // TypedArray views.
-    // In the event these views are detached, we need to recreate them.
-    // This can happen when loading large .riv files or when the WASM memory
-    // is expanded.
-    // Only recreate the data if it is empty and the pointer is not 0 (disposed).
-    // See: https://github.com/emscripten-core/emscripten/issues/7294
-    if (_data.isEmpty && _pointer != 0.toJS) {
+    // Memory growth detaches old heap views. dart2wasm caches their length,
+    // so isEmpty cannot detect detachment. Refresh every non-disposed access.
+    if (_pointer != 0.toJS) {
       _data = RiveWasm.heap((_pointer as js.JSNumber).toDartInt, size);
       return _data;
     }
-- 
