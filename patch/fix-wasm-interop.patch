From d4c5cdc97e41709d04248866ad5aadafb43a2f56 Mon Sep 17 00:00:00 2001
From: rydmike <mrydstrom+gh@gmail.com>
Date: Wed, 21 Oct 2026 10:36:44 +0300
Subject: [PATCH 1/2] Convert JavaScript enum values to Dart strings

A JS array's .toDart converts the array, not its elements. Under dart2wasm the elements remain JS values, so a lazy cast to String fails when read. Convert each JSString explicitly before returning the values.
---
 lib/src/web/rive_web.dart | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/src/web/rive_web.dart b/lib/src/web/rive_web.dart
index 9848304..b8a0371 100644
--- a/lib/src/web/rive_web.dart
+++ b/lib/src/web/rive_web.dart
@@ -933,9 +933,11 @@ class WebRiveFile extends File {
     for (int i = 0; i < length; i++) {
       final jsProp = result.getProperty(i.toJS) as js.JSObject;
       final name = (jsProp.getProperty('name'.toJS) as js.JSString).toDart;
+      // JSArray.toDart converts the array, not its JS string elements.
       final values = (jsProp.getProperty('values'.toJS) as js.JSArray)
           .toDart
-          .cast<String>();
+          .map((e) => (e as js.JSString).toDart)
+          .toList();
       dataEnums.add(DataEnum(name, values));
     }
     return dataEnums;
-- 
